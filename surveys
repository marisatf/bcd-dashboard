    <script>
        // DATA MODEL
        const mockData = {
            sent: 27,
            received: 21,
            csat: 59.5,
            detractors: 4,
            passives: 5,
            promoters: 12,
            npsDistribution: [0, 1, 0, 1, 1, 1, 0, 2, 3, 5, 7], // 0-10 scale counts
            trendMonths: ['May', 'Jun', 'Jul', 'Ago', 'Sep', 'Oct'],
            trendCSAT: [52, 55, 58, 62, 57, 59.5],
            trendNPS: [15, 20, 28, 35, 30, 38],
            trendPromoters: [40, 45, 50, 58, 52, 57]
        };

        let embedFitActive = false;

        window.onload = function() {
            renderBarChart();
            renderLineChart();
            window.addEventListener('resize', () => {
                renderBarChart();
                renderLineChart();
            });

            // ANTI-TIINY HOST DOM OBSERVER & CLEANER
            cleanTiinyHostBanners();
            setInterval(cleanTiinyHostBanners, 500);
        };

        // Aggressively remove any element injected by Tiiny.host
        function cleanTiinyHostBanners() {
            const selectors = [
                'a[href*="tiiny.host"]',
                'div[style*="position: fixed"]',
                'div[style*="position:fixed"]',
                'iframe[src*="tiiny.host"]',
                '#tiiny-host-banner'
            ];

            selectors.forEach(sel => {
                document.querySelectorAll(sel).forEach(el => {
                    if (el.id !== 'app-wrapper') {
                        el.remove();
                    }
                });
            });

            // Ensure body overflow stays hidden
            document.body.style.overflow = 'hidden';
        }

        // Toggle Embed Fit Mode (hides redundant sidebar & topbar)
        function toggleEmbedFitMode() {
            const sidebar = document.getElementById('internal-sidebar');
            const header = document.getElementById('internal-header');
            const btnText = document.getElementById('embed-toggle-text');

            embedFitActive = !embedFitActive;

            if (embedFitActive) {
                sidebar.classList.add('hidden');
                header.classList.add('py-0.5');
                btnText.textContent = "Mostrar Completo";
            } else {
                sidebar.classList.remove('hidden');
                header.classList.remove('py-0.5');
                btnText.textContent = "Modo Embebido";
            }

            // Re-render charts after transition to update SVG dimensions
            setTimeout(() => {
                renderBarChart();
                renderLineChart();
            }, 200);
        }

        function toggleSidebar() {
            const sidebar = document.getElementById('internal-sidebar');
            sidebar.classList.toggle('hidden');
            setTimeout(() => {
                renderBarChart();
                renderLineChart();
            }, 200);
        }

        function applyFilters() {
            // Re-calculate mock values based on filters
            const period = document.getElementById('filter-period').value;
            const mult = period === '3m' ? 0.6 : (period === '30d' ? 0.25 : 1);

            const sent = Math.round(mockData.sent * mult);
            const rec = Math.round(mockData.received * mult);
            const rate = ((rec / sent) * 100).toFixed(1);

            document.getElementById('kpi-sent').textContent = sent;
            document.getElementById('kpi-received').textContent = rec;
            document.getElementById('kpi-response-rate').textContent = rate + '%';
            document.getElementById('kpi-response-detail').textContent = `${rec} respuestas de ${sent} envíos`;

            renderBarChart();
            renderLineChart();
        }

        function resetFilters() {
            document.getElementById('filter-period').value = '6m';
            document.getElementById('filter-touchpoint').value = 'post-viaje';
            document.getElementById('filter-channel').value = 'telefono';
            document.getElementById('filter-team').value = 'Equipo C';
            applyFilters();
        }

        // RENDER SVG BAR CHART (NPS Distribution)
        function renderBarChart() {
            const container = document.getElementById('bar-chart-container');
            const svg = document.getElementById('bar-chart-svg');
            if (!container || !svg) return;

            const width = container.clientWidth;
            const height = container.clientHeight;
            svg.setAttribute('viewBox', `0 0 ${width} ${height}`);
            svg.innerHTML = '';

            const paddingLeft = 20;
            const paddingBottom = 18;
            const paddingTop = 10;
            const paddingRight = 10;

            const chartW = width - paddingLeft - paddingRight;
            const chartH = height - paddingTop - paddingBottom;

            const data = mockData.npsDistribution;
            const maxVal = Math.max(...data, 8);
            const barGap = 4;
            const barWidth = (chartW / data.length) - barGap;

            // Render Horizontal Gridlines
            [0, 0.5, 1].forEach(ratio => {
                const y = paddingTop + chartH * (1 - ratio);
                const line = document.createElementNS('http://www.w3.org/2000/svg', 'line');
                line.setAttribute('x1', paddingLeft);
                line.setAttribute('y1', y);
                line.setAttribute('x2', width - paddingRight);
                line.setAttribute('y2', y);
                line.setAttribute('stroke', '#334155');
                line.setAttribute('stroke-dasharray', '2,2');
                svg.appendChild(line);
            });

            // Render Bars
            data.forEach((val, i) => {
                const x = paddingLeft + i * (barWidth + barGap) + barGap/2;
                const barH = (val / maxVal) * chartH;
                const y = paddingTop + (chartH - barH);

                let color = '#f43f5e'; // Detractor (Red)
                if (i >= 7 && i <= 8) color = '#f59e0b'; // Passive (Amber)
                if (i >= 9) color = '#10b981'; // Promoter (Green)

                const rect = document.createElementNS('http://www.w3.org/2000/svg', 'rect');
                rect.setAttribute('x', x);
                rect.setAttribute('y', y);
                rect.setAttribute('width', Math.max(1, barWidth));
                rect.setAttribute('height', Math.max(2, barH));
                rect.setAttribute('fill', color);
                rect.setAttribute('rx', '2');
                rect.setAttribute('class', 'transition-all duration-300 hover:opacity-80 cursor-pointer');

                // Hover Tooltip
                rect.addEventListener('mouseenter', (e) => showTooltip(e, `Score: ${i}`, `Respuestas: <b class="text-white">${val}</b>`));
                rect.addEventListener('mouseleave', hideTooltip);

                svg.appendChild(rect);

                // X-Axis Labels
                const text = document.createElementNS('http://www.w3.org/2000/svg', 'text');
                text.setAttribute('x', x + barWidth / 2);
                text.setAttribute('y', height - 3);
                text.setAttribute('fill', '#94a3b8');
                text.setAttribute('font-size', '8');
                text.setAttribute('text-anchor', 'middle');
                text.textContent = i;
                svg.appendChild(text);
            });
        }

        // RENDER SVG LINE CHART (Trend)
        function renderLineChart() {
            const container = document.getElementById('line-chart-container');
            const svg = document.getElementById('line-chart-svg');
            if (!container || !svg) return;

            const width = container.clientWidth;
            const height = container.clientHeight;
            svg.setAttribute('viewBox', `0 0 ${width} ${height}`);
            svg.innerHTML = '';

            const paddingLeft = 22;
            const paddingBottom = 18;
            const paddingTop = 10;
            const paddingRight = 10;

            const chartW = width - paddingLeft - paddingRight;
            const chartH = height - paddingTop - paddingBottom;

            const months = mockData.trendMonths;
            const csat = mockData.trendCSAT;
            const nps = mockData.trendNPS;

            // Render Horizontal Gridlines
            [0, 0.5, 1].forEach((ratio, idx) => {
                const y = paddingTop + chartH * (1 - ratio);
                const line = document.createElementNS('http://www.w3.org/2000/svg', 'line');
                line.setAttribute('x1', paddingLeft);
                line.setAttribute('y1', y);
                line.setAttribute('x2', width - paddingRight);
                line.setAttribute('y2', y);
                line.setAttribute('stroke', '#334155');
                line.setAttribute('stroke-dasharray', '2,2');
                svg.appendChild(line);

                const label = document.createElementNS('http://www.w3.org/2000/svg', 'text');
                label.setAttribute('x', paddingLeft - 3);
                label.setAttribute('y', y + 3);
                label.setAttribute('fill', '#64748b');
                label.setAttribute('font-size', '7');
                label.setAttribute('text-anchor', 'end');
                label.textContent = `${Math.round(ratio * 100)}%`;
                svg.appendChild(label);
            });

            // Generate Path Points
            const getPoints = (dataset) => {
                return dataset.map((val, i) => {
                    const x = paddingLeft + (i / (dataset.length - 1)) * chartW;
                    const y = paddingTop + chartH * (1 - val / 100);
                    return { x, y, val };
                });
            };

            const drawSeries = (dataset, color) => {
                const pts = getPoints(dataset);
                const pathD = pts.reduce((acc, p, i) => `${acc} ${i === 0 ? 'M' : 'L'} ${p.x} ${p.y}`, '');

                const path = document.createElementNS('http://www.w3.org/2000/svg', 'path');
                path.setAttribute('d', pathD);
                path.setAttribute('fill', 'none');
                path.setAttribute('stroke', color);
                path.setAttribute('stroke-width', '1.8');
                svg.appendChild(path);

                // Points
                pts.forEach((p, i) => {
                    const circle = document.createElementNS('http://www.w3.org/2000/svg', 'circle');
                    circle.setAttribute('cx', p.x);
                    circle.setAttribute('cy', p.y);
                    circle.setAttribute('r', '2.5');
                    circle.setAttribute('fill', color);
                    circle.setAttribute('class', 'hover:scale-150 transition-transform cursor-pointer');

                    circle.addEventListener('mouseenter', (e) => showTooltip(e, months[i], `Valor: <b class="text-white">${p.val}%</b>`));
                    circle.addEventListener('mouseleave', hideTooltip);

                    svg.appendChild(circle);
                });
            };

            drawSeries(csat, '#3b82f6'); // Blue Line (CSAT)
            drawSeries(nps, '#f43f5e');  // Red Line (NPS)

            // Render X-Axis Labels
            months.forEach((m, i) => {
                const x = paddingLeft + (i / (months.length - 1)) * chartW;
                const text = document.createElementNS('http://www.w3.org/2000/svg', 'text');
                text.setAttribute('x', x);
                text.setAttribute('y', height - 3);
                text.setAttribute('fill', '#94a3b8');
                text.setAttribute('font-size', '8');
                text.setAttribute('text-anchor', 'middle');
                text.textContent = m;
                svg.appendChild(text);
            });
        }

        // TOOLTIP HELPER FUNCTIONS
        function showTooltip(e, title, body) {
            const tooltip = document.getElementById('tooltip');
            document.getElementById('tooltip-title').innerHTML = title;
            document.getElementById('tooltip-body').innerHTML = body;

            const rect = e.target.getBoundingClientRect();
            tooltip.style.left = `${rect.left + rect.width / 2}px`;
            tooltip.style.top = `${rect.top - 8}px`;
            tooltip.style.opacity = '1';
        }

        function hideTooltip() {
            const tooltip = document.getElementById('tooltip');
            tooltip.style.opacity = '0';
        }

        function handleSearch() {
            const query = document.getElementById('global-search').value.toLowerCase();
            console.log('Filtrando dashboard por:', query);
        }

        function exportChart(chartId) {
            alert('Exportación iniciada para ' + chartId);
        }
    </script>
</body>
